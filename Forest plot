library(readxl)
library(dplyr)
library(ggplot2)
library(stringr)

file_path <- file.choose()

data <- read_excel(file_path, sheet = 1, skip = 1)

names(data) <- str_trim(names(data))

required_columns <- c("Region", "IRR", "95% CI")

missing_columns <- setdiff(required_columns, names(data))

if (length(missing_columns) > 0) {
  stop(
    paste(
      "Missing required Excel columns:",
      paste(missing_columns, collapse = ", "),
      "\nAvailable columns are:",
      paste(names(data), collapse = ", ")
    )
  )
}

forest_data <- data %>%
  mutate(
    Region = str_trim(as.character(Region)),
    IRR = as.numeric(IRR),
    CI_text = str_replace_all(as.character(`95% CI`), "[–—−]", "-"),
    CI_text = str_remove_all(CI_text, "[()]"),
    CI_lower = as.numeric(str_match(CI_text, "^\\s*([0-9.]+)\\s*-")[, 2]),
    CI_upper = as.numeric(str_match(CI_text, "-\\s*([0-9.]+)\\s*$")[, 2])
  ) %>%
  filter(
    !is.na(Region),
    Region != "",
    !is.na(IRR),
    !is.na(CI_lower),
    !is.na(CI_upper)
  )

forest_data <- forest_data %>%
  mutate(
    Region = factor(Region, levels = rev(unique(Region)))
  )

print(forest_data %>% select(Region, IRR, CI_lower, CI_upper))

forest_plot <- ggplot(forest_data, aes(x = IRR, y = Region)) +
  geom_vline(
    xintercept = 1,
    linetype = "dashed",
    color = "grey50",
    linewidth = 0.6
  ) +
  geom_segment(
    aes(x = CI_lower, xend = CI_upper, yend = Region),
    linewidth = 0.6,
    color = "black"
  ) +
  geom_point(
    shape = 15,
    size = 2.5,
    color = "black"
  ) +
  scale_x_continuous(
    breaks = seq(0.6, 1.2, by = 0.1),
    limits = c(0.7, 1.1),
    expand = expansion(mult = c(0.02, 0.02))
  ) +
  labs(
    title = "Partial meniscectomy",
    x = "Incidence rate ratio (IRR)",
    y = NULL
  ) +
  coord_cartesian(clip = "off") +
  theme_classic(base_size = 11) +
  theme(
    plot.title = element_text(
      face = "bold",
      size = 14,
      hjust = 0.5,
      margin = margin(b = 18)
    ),
    axis.text.y = element_text(
      color = "black",
      size = 9.5
    ),
    axis.text.x = element_text(
      color = "black"
    ),
    axis.title.x = element_text(
      margin = margin(t = 10)
    ),
    plot.margin = margin(
      t = 12,
      r = 15,
      b = 15,
      l = 10
    )
  )

print(forest_plot)

ggsave(
  filename = "Forest_Plot_Total_Meniscectomy.pdf",
  plot = forest_plot,
  width = 8,
  height = 8.5,
  device = cairo_pdf
)

ggsave(
  filename = "Forest_Plot_Total_Meniscectomy.png",
  plot = forest_plot,
  width = 8,
  height = 8.5,
  dpi = 600,
  bg = "white"
)

cat(
  "\nForest plot updated successfully.\n",
  "Files saved in: ", getwd(), "\n",
  "PDF: Forest_Plot_Total_Meniscectomy.pdf\n",
  "PNG: Forest_Plot_Total_Meniscectomy.png\n"
)

